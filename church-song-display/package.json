{
  "name": "church-song-display",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Church song presentation system",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
    },
  "dependencies": {
    "dotenv": "^18.0.4",  
    "electron": "^44.4.5",
    "mysql2": "^3.24.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
        "appId": "org.church.songdisplay",

        "productName": "Church Song Display",

        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],

        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],

            "category": "AudioVideo"
        }
    }   
}
